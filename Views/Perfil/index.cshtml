
@model CentroDeCopias.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container-fluid mt-4 mb-5"
     style="max-width: 1400px;">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body p-4 p-lg-5">

            <!-- ENCABEZADO DEL PERFIL -->
            <div class="d-flex align-items-center gap-4 mb-4">

                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar"
                         alt="Foto de perfil"
                         class="rounded-circle"
                         style="width: 120px;
                                height: 120px;
                                object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary
                                d-flex align-items-center
                                justify-content-center"
                         style="width: 120px;
                                height: 120px;
                                flex-shrink: 0;">

                        <span class="text-white"
                              style="font-size: 55px;">
                            👤
                        </span>
                    </div>
                }

                <div>
                    <h2 class="fw-bold mb-2">
                        @Model.nombre @Model.apellido
                    </h2>

                    <span class="badge bg-primary">
                        @Model.Rol
                    </span>

                    <p class="text-muted mt-2 mb-0">
                        Mi cuenta de Center Copia
                    </p>
                </div>

            </div>

            <hr class="my-4" />

            <div class="row g-5">

                <!-- INFORMACIÓN PERSONAL -->
                <div class="col-lg-7">

                    <div class="d-flex justify-content-between
                                align-items-center mb-4">

                        <h4 class="mb-0">
                            Información personal
                        </h4>

                        <!-- BOTÓN EDITAR -->
                        <button type="button"
                                id="btnEditar"
                                class="btn btn-outline-primary btn-sm"
                                onclick="activarEdicion()">

                            Editar información
                        </button>

                    </div>

                    <!-- DATOS EN MODO LECTURA -->
                    <div id="datosLectura">

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label class="text-muted">
                                    Nombre
                                </label>

                                <h5>@Model.nombre</h5>
                            </div>

                            <div class="col-md-6">
                                <label class="text-muted">
                                    Apellido
                                </label>

                                <h5>@Model.apellido</h5>
                            </div>

                            <div class="col-12">
                                <label class="text-muted">
                                    Correo electrónico
                                </label>

                                <h5>@Model.email</h5>
                            </div>

                            <div class="col-12">
                                <label class="text-muted">
                                    Tipo de cuenta
                                </label>

                                <h5>@Model.Rol</h5>
                            </div>

                        </div>

                    </div>

                    <!-- FORMULARIO DE EDICIÓN -->
                    <div id="datosEdicion" class="d-none">

                        <form asp-controller="Perfil"
                              asp-action="Editar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="row g-3">

                                <!-- NOMBRE -->
                                <div class="col-md-6">

                                    <label for="nombre"
                                           class="form-label">
                                        Nombre
                                    </label>

                                    <input type="text"
                                           id="nombre"
                                           name="nombre"
                                           value="@Model.nombre"
                                           class="form-control"
                                           maxlength="50"
                                           required />
                                </div>

                                <!-- APELLIDO -->
                                <div class="col-md-6">

                                    <label for="apellido"
                                           class="form-label">
                                        Apellido
                                    </label>

                                    <input type="text"
                                           id="apellido"
                                           name="apellido"
                                           value="@Model.apellido"
                                           class="form-control"
                                           maxlength="50"
                                           required />
                                </div>

                                <!-- EMAIL -->
                                <div class="col-12">

                                    <label for="email"
                                           class="form-label">
                                        Correo electrónico
                                    </label>

                                    <input type="email"
                                           id="email"
                                           name="email"
                                           value="@Model.email"
                                           class="form-control"
                                           maxlength="100"
                                           required />
                                </div>

                                <!-- ROL -->
                                <div class="col-12">

                                    <label class="form-label">
                                        Tipo de cuenta
                                    </label>

                                    <input type="text"
                                           value="@Model.Rol"
                                           class="form-control"
                                           readonly />
                                </div>

                            </div>

                            <!-- BOTONES -->
                            <div class="d-flex gap-2 mt-4">

                                <button type="submit"
                                        class="btn btn-primary">

                                    Guardar cambios
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="cancelarEdicion()">

                                    Cancelar
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

                <!-- FOTO DE PERFIL -->
                <div class="col-lg-5">

                    <h4 class="mb-4">
                        Foto de perfil
                    </h4>

                    <p class="text-muted">
                        Podés subir una imagen JPG o PNG
                        de hasta 2 MB.
                    </p>

                    <form asp-controller="Perfil"
                          asp-action="SubirAvatar"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label for="archivo"
                                   class="form-label">
                                Seleccionar imagen
                            </label>

                            <input type="file"
                                   name="archivo"
                                   id="archivo"
                                   class="form-control"
                                   accept="image/jpeg,image/png"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-primary">

                            Guardar foto
                        </button>

                    </form>

                </div>

            </div>

            <hr class="my-4" />

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">

                Volver al inicio
            </a>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        // ACTIVAR MODO EDICIÓN
        function activarEdicion() {

            document.getElementById("datosLectura")
                .classList.add("d-none");

            document.getElementById("datosEdicion")
                .classList.remove("d-none");

            document.getElementById("btnEditar")
                .classList.add("d-none");
        }

        // CANCELAR EDICIÓN
        function cancelarEdicion() {

            // Restaurar los valores originales
            document.querySelector("#datosEdicion form").reset();

            document.getElementById("datosEdicion")
                .classList.add("d-none");

            document.getElementById("datosLectura")
                .classList.remove("d-none");

            document.getElementById("btnEditar")
                .classList.remove("d-none");
        }

    </script>

}
