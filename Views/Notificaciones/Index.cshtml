
@model IEnumerable<CentroDeCopias.Models.Notificacion>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="container py-4 py-lg-5" style="max-width: 1100px;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Notificaciones</h2>
            <p class="text-muted mb-0">
                Consultá las novedades de tus pedidos.
            </p>
        </div>

        @if (@ViewBag.SinLeer > 0)
        {
            <form asp-action="MarcarTodasLeidas" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check2-all me-1"></i>
                    Marcar todas como leídas
                </button>
            </form>
        }
    </div>

    <!-- RESUMEN -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Total de notificaciones</p>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalNotificaciones</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Sin leer</p>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.SinLeer</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- LISTADO -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash fs-1 text-muted"></i>

                    <h5 class="mt-3">No tenés notificaciones</h5>

                    <p class="text-muted">
                        Cuando haya novedades, aparecerán acá.
                    </p>
                </div>
            }
            else
            {
                @foreach (var notificacion in Model)
                {
                    <div class="border-bottom p-4
                        @(notificacion.Leida ? "" : "bg-primary bg-opacity-10")">

                        <div class="d-flex justify-content-between gap-3">

                            <div class="d-flex gap-3">

                                <!-- ICONO -->
                                <div>
                                    @if (notificacion.Tipo == "Pedido")
                                    {
                                        <i class="bi bi-bag-check fs-3 text-primary"></i>
                                    }
                                    else if (notificacion.Tipo == "Stock")
                                    {
                                        <i class="bi bi-box-seam fs-3 text-warning"></i>
                                    }
                                    else if (notificacion.Tipo == "Documento")
                                    {
                                        <i class="bi bi-file-earmark-text fs-3 text-info"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bell fs-3 text-secondary"></i>
                                    }
                                </div>

                                <!-- INFORMACIÓN -->
                                <div>
                                    <h6 class="fw-bold mb-1">
                                        @notificacion.Titulo

                                        @if (!notificacion.Leida)
                                        {
                                            <span class="badge bg-primary ms-2">
                                                Nueva
                                            </span>
                                        }
                                    </h6>

                                    <p class="text-muted mb-2">
                                        @notificacion.Mensaje
                                    </p>

                                    <small class="text-muted">
                                        @(notificacion.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                    </small>
                                </div>
                            </div>

                            <!-- ACCIONES -->
                            <div class="d-flex flex-column gap-2 align-items-end">

                                @if (notificacion.id_pedido.HasValue)
                                {
                                    <a asp-action="IrAPedido"
                                       asp-route-id="@notificacion.IdNotificacion"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver pedido
                                    </a>
                                }

                                @if (!notificacion.Leida)
                                {
                                    <form asp-action="MarcarLeida" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notificacion.IdNotificacion" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Marcar leída
                                        </button>
                                    </form>
                                }
                            </div>

                        </div>
                    </div>
                }
            }

        </div>
    </div>

</div>
