@model IEnumerable<CentroDeCopias.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">+ Nuevo producto</a>
    </p>
}

<div class="form-group mb-4">
    <input type="text" id="buscador" class="form-control" placeholder="Buscar productos..." autocomplete="off" />
</div>

<div id="contenedor-productos">
    @await Html.PartialAsync("_ProductosCards", Model)
</div>

@section Scripts {
    <script>
        const input = document.getElementById('buscador');
        const contenedor = document.getElementById('contenedor-productos');
        let timeoutId;

        input.addEventListener('input', () => {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => buscar(input.value), 300);
        });

        async function buscar(texto) {
            const resp = await fetch(`/Productos/Buscar?q=${encodeURIComponent(texto)}`);
            contenedor.innerHTML = await resp.text();
        }
    </script>
}