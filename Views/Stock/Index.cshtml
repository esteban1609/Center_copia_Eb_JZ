@model IEnumerable<CentroDeCopias.Models.Stock>

@{
    ViewData["Title"] = "Stock";
}

<h1>Stock</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro de stock</a>
</p>

<div class="form-group mb-4">
    <input type="text" id="buscadorStock" class="form-control" placeholder="Buscar por producto..." autocomplete="off" />
</div>

<div id="contenedor-stock">
    @await Html.PartialAsync("_StockTable", Model)
</div>

@section Scripts {
    <script>
        const input = document.getElementById('buscadorStock');
        const contenedor = document.getElementById('contenedor-stock');
        let timeoutId;

        input.addEventListener('input', () => {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => buscar(input.value), 300);
        });

        async function buscar(texto) {
            const resp = await fetch(`/Stock/Buscar?q=${encodeURIComponent(texto)}`);
            contenedor.innerHTML = await resp.text();
        }
    </script>
}