@model CentroDeCopias.Models.Stock

@{
    ViewData["Title"] = "Editar stock";
}

<h1>Editar stock</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="IdStock" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="IdProducto" class="control-label">Producto</label>
        <select asp-for="IdProducto" class="form-control" asp-items="ViewBag.IdProducto"></select>
    </div>
    <div class="form-group">
        <label asp-for="CantidadDisponible" class="control-label"></label>
        <input asp-for="CantidadDisponible" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="StockMinimo" class="control-label"></label>
        <input asp-for="StockMinimo" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Guardar" class="btn btn-primary" />
    </div>
</form>

<a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>