
@model IEnumerable<CentroDeCopias.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4 py-lg-5"
     style="max-width: 1250px;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-2">
                Gestión de usuarios
            </h2>

            <p class="text-muted mb-0">
                Administrá las cuentas y los permisos
                de los usuarios de Center Copia.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">

            + Nuevo usuario
        </a>

    </div>

    <!-- TARJETAS DE RESUMEN -->
    <div class="row g-3 mb-4">

        <!-- TOTAL -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <p class="text-muted mb-2">
                        Total de usuarios
                    </p>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalUsuarios
                    </h3>

                </div>
            </div>
        </div>

        <!-- ACTIVOS -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <p class="text-muted mb-2">
                        Usuarios activos
                    </p>

                    <h3 class="fw-bold text-success mb-0">
                        @ViewBag.UsuariosActivos
                    </h3>

                </div>
            </div>
        </div>

        <!-- INACTIVOS -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <p class="text-muted mb-2">
                        Usuarios inactivos
                    </p>

                    <h3 class="fw-bold text-danger mb-0">
                        @ViewBag.UsuariosInactivos
                    </h3>

                </div>
            </div>
        </div>

    </div>

    <!-- LISTADO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2 mb-4">

                <h5 class="fw-bold mb-0">
                    Listado de usuarios
                </h5>

                <span class="text-muted small">
                    @ViewBag.TotalUsuarios registros
                </span>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th class="py-3">Usuario</th>
                            <th class="py-3">Correo electrónico</th>
                            <th class="py-3">Rol</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3 text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="fs-1 mb-2">
                                        👥
                                    </div>

                                    <h6 class="fw-bold">
                                        No hay usuarios registrados
                                    </h6>

                                    <p class="text-muted mb-0">
                                        Creá un usuario para comenzar.
                                    </p>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var usuario in Model)
                            {
                                <tr>

                                    <!-- NOMBRE Y APELLIDO -->
                                    <td>
                                        <div class="fw-semibold">
                                            @usuario.nombre @usuario.apellido
                                        </div>
                                    </td>

                                    <!-- EMAIL -->
                                    <td class="text-muted">
                                        @usuario.email
                                    </td>

                                    <!-- ROL -->
                                    <td>
                                        @if (usuario.Rol == "Admin")
                                        {
                                            <span class="badge bg-primary">
                                                Administrador
                                            </span>
                                        }
                                        else if (usuario.Rol == "Escuela")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Escuela
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @usuario.Rol
                                            </span>
                                        }
                                    </td>

                                    <!-- ESTADO -->
                                    <td>
                                        @if (usuario.activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <!-- ACCIONES -->
                                    <td class="text-end">

                                        <div class="d-flex
                                                    justify-content-end
                                                    gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@usuario.id_Usuario"
                                               class="btn btn-outline-primary btn-sm">

                                                Editar
                                            </a>

                                            @if (usuario.activo)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalDesactivar-@usuario.id_Usuario">

                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="Reactivar"
                                                      asp-route-id="@usuario.id_Usuario"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-outline-success btn-sm">

                                                        Reactivar
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- MODALES PARA DESACTIVAR USUARIOS -->
    @foreach (var usuario in Model.Where(u => u.activo))
    {
        <div class="modal fade"
             id="modalDesactivar-@usuario.id_Usuario"
             tabindex="-1"
             aria-labelledby="tituloModal-@usuario.id_Usuario"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content border-0 rounded-4 shadow">

                    <!-- ENCABEZADO -->
                    <div class="modal-header border-0 pb-0">

                        <h5 class="modal-title fw-bold"
                            id="tituloModal-@usuario.id_Usuario">

                            Desactivar usuario
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <!-- MENSAJE -->
                    <div class="modal-body py-4">

                        <p>
                            ¿Estás seguro de que querés desactivar
                            al usuario
                            <strong>
                                @usuario.nombre @usuario.apellido
                            </strong>?
                        </p>

                        <div class="alert alert-warning mb-0">

                            El usuario permanecerá registrado
                            en la base de datos y podrá
                            reactivarse posteriormente.

                        </div>

                    </div>

                    <!-- BOTONES -->
                    <div class="modal-footer border-0 pt-0">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            Cancelar
                        </button>

                        <form asp-action="Desactivar"
                              asp-route-id="@usuario.id_Usuario"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger">

                                Confirmar desactivación
                            </button>

                        </form>

                    </div>

                </div>
            </div>
        </div>
    }

</div>
