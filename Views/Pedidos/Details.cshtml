@model CentroDeCopias.Models.Pedido

@{
    ViewData["Title"] = "Detalle del pedido";
}

<h1>Pedido #@Model.id_pedido</h1>

<dl class="row">
    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.Usuario.nombre @Model.Usuario.apellido</dd>

    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.fecha.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.estado</dd>

    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.total.ToString("C")</dd>
</dl>

<h3>Documentos para imprimir</h3>
@if (!Model.Documentos.Any())
{
    <p><em>No hay documentos cargados en este pedido.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Copias</th>
                <th>Color</th>
                <th>Doble faz</th>
                <th>Tamaño</th>
                <th>Anillado</th>
                <th>Precio</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model.Documentos)
        {
            <tr>
                <td>@d.Nombre</td>
                <td>@d.Copias</td>
                <td>@(d.Color ? "Sí" : "No")</td>
                <td>@(d.DobleFaz ? "Sí" : "No")</td>
                <td>@d.TamanoHoja</td>
                <td>@d.Anillado</td>
                <td>@d.Precio.ToString("C")</td>
                <td><a href="@d.RutaArchivo" target="_blank">Ver PDF</a></td>
            </tr>
        }
        </tbody>
    </table>
}

<h3>Productos</h3>
@if (!Model.Detalles.Any())
{
    <p><em>No hay productos cargados en este pedido.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto.Nombre</td>
                <td>@d.cantidad</td>
                <td>@d.precio.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.estado == "Pendiente")
{
    <form asp-action="Confirmar" asp-route-id="@Model.id_pedido" method="post" style="display:inline">
        <input type="submit" value="Confirmar pedido" class="btn btn-success" />
    </form>
}
@if (User.IsInRole("Admin"))
{
    <a asp-action="EditarEstado" asp-route-id="@Model.id_pedido" class="btn btn-warning">Cambiar estado</a> <text>|</text>
}
else if (Model.estado == "Pendiente")
{
    <a asp-action="Edit" asp-route-id="@Model.id_pedido" class="btn btn-light">Editar</a> <text>|</text>
}
<a asp-action="Index" class="btn btn-primary">Volver a la lista</a>