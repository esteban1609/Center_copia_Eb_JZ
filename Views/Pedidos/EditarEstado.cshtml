@model CentroDeCopias.Models.Pedido

@{
    ViewData["Title"] = "Editar estado del pedido";
}

<h1>Editar estado del pedido #@Model.id_pedido</h1>

<p>Cliente: @Model.Usuario.nombre @Model.Usuario.apellido</p>

<form asp-action="EditarEstado" method="post">
    <input type="hidden" name="id" value="@Model.id_pedido" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Estado</label>
        <select name="estado" class="form-control" asp-items="ViewBag.Estados"></select>
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" class="btn btn-primary" />
    </div>
</form>


<a asp-action="Details" asp-route-id="@Model.id_pedido" class="btn btn-secondary" >Volver al pedido</a>